{
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5-nano-2025-08-07",
        "fallbacks": ["google/gemini-3-flash-preview", "minimax-portal/MiniMax-M2.5"]
      },
      "models": {
        "minimax-portal/MiniMax-M2.5": {
          "alias": "minimax"
