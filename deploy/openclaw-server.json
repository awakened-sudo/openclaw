  "bindings": [
    {
      "agentId": "speaker",
      "match": {
        "channel": "telegram",
        "accountId": "speaker"
      }
    },
    {
      "agentId": "pm",
      "match": {
        "channel": "telegram",
        "accountId": "pm"
      }
    },
    {
      "agentId": "mp-p022",
      "match": {
        "channel": "telegram",
        "accountId": "mp-p022"
      }
    },
    {
      "agentId": "mp-p019",
      "match": {
        "channel": "telegram",
        "accountId": "mp-p019"
      }
    },
    {
      "agentId": "mp-p160",
      "match": {
        "channel": "telegram",
        "accountId": "mp-p160"
      }
    },
    {
      "agentId": "mp-p197",
      "match": {
        "channel": "telegram",
        "accountId": "mp-p197"
      }
    },
    {
      "agentId": "mp-p074",
      "match": {
        "channel": "telegram",
        "accountId": "mp-p074"
      }
