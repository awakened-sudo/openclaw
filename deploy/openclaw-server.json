        },
        "mp-p022": {
          "name": "MP Gua Musang (P.022)",
          "botToken": "REPLACE_MP_P022_BOT_TOKEN"
        },
        "mp-p019": {
          "name": "MP Kota Bharu (P.019)",
          "botToken": "REPLACE_MP_P019_BOT_TOKEN"
        },
        "mp-p160": {
          "name": "MP Iskandar Puteri (P.160)",
          "botToken": "REPLACE_MP_P160_BOT_TOKEN"
        },
        "mp-p197": {
          "name": "MP Kuching (P.197)",
          "botToken": "REPLACE_MP_P197_BOT_TOKEN"
        },
        "mp-p074": {
          "name": "MP Tambun (P.074)",
          "botToken": "REPLACE_MP_P074_BOT_TOKEN"
        }
      }
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "controlUi": {
      "enabled": true,
      "dangerouslyAllowHostHeaderOriginFallback": true
    },
    "auth": {
      "mode": "token"
    },
    "reload": {
      "mode": "hybrid",
      "debounceMs": 300
    },
    "tailscale": {
      "mode": "off"
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "calendar.add",
        "contacts.add",
        "reminders.add"
      ]
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "minimax-portal-auth": {
        "enabled": true
      }
    }
  },
  "messages": {
    "suppressToolErrors": true,
    "ackReactionScope": "group-mentions"
  },
  "tools": {
    "agentToAgent": {
      "enabled": true,
      "allow": ["speaker", "pm", "mp-p019", "mp-p022", "mp-p074", "mp-p160", "mp-p197"]
    },
    "sessions": {
      "visibility": "all"
    }
  },
  "memory": {
    "backend": "builtin",
    "citations": "auto"
  },
  "cron": {
    "enabled": true,
    "maxConcurrentRuns": 2,
    "sessionRetention": "48h"
  },
  "hooks": {
    "internal": {
      "entries": {
        "boot-md": {
          "enabled": true
        },
        "session-memory": {
          "enabled": true
        },
        "command-logger": {
          "enabled": true
        }
      },
      "enabled": true
    }
  },
  "models": {
    "providers": {
      "minimax-portal": {
        "baseUrl": "https://api.minimax.io/anthropic",
        "apiKey": "minimax-oauth",
        "api": "anthropic-messages",
        "models": [
          {
            "id": "MiniMax-M2.5",
            "name": "MiniMax M2.5",
            "reasoning": true,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 200000,
            "maxTokens": 8192
          },
          {
            "id": "MiniMax-M2.1",
            "name": "MiniMax M2.1",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      },
      "google": {
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
        "apiKey": "${GOOGLE_AI_API_KEY}",
        "api": "google-generative-ai",
        "models": [
          {
            "id": "gemini-3-flash-preview",
            "name": "Gemini 3 Flash",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 1048576,
            "maxTokens": 65536
          }
        ]
      },
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "apiKey": "${OPENAI_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "gpt-5-nano-2025-08-07",
            "name": "GPT-5 Nano",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 5e-5, "output": 0.0002, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": 128000,
            "maxTokens": 16384
          }
        ]
      }
    },
    "mode": "merge"
  },
  "auth": {
    "profiles": {
      "minimax-portal:default": {
        "provider": "minimax-portal",
        "mode": "oauth"
      }
    }
  },
  "skills": {
    "entries": {
      "nano-banana-pro": {
        "apiKey": "${GOOGLE_AI_API_KEY}"
      },
      "openai-image-gen": {
        "apiKey": "${OPENAI_API_KEY}"
      },
      "openai-whisper-api": {
        "apiKey": "${OPENAI_API_KEY}"
      }
    }
  },
  "session": {
    "dmScope": "per-channel-peer",
    "agentToAgent": {
      "maxPingPongTurns": 0
    }
  }
}
