  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "allowFrom": ["142213678", "1797956910"],
      "groups": {
        "*": {
          "requireMention": true
        },
        "-5196441657": {
          "requireMention": false
        }
      },
      "groupAllowFrom": ["142213678", "1797956910"],
      "groupPolicy": "allowlist",
      "streaming": "off",
      "accounts": {
        "speaker": {
          "name": "Speaker of Dewan Rakyat",
          "botToken": "REPLACE_SPEAKER_BOT_TOKEN",
          "customCommands": [
            {
              "command": "buka_sidang",
              "description": "Buka sidang Dewan (Open session)"
            },
            {
              "command": "tutup_sidang",
